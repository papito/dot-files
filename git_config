# Commands to run for a new git installation
# https://www.youtube.com/watch?v=aolI_Rz0ZqY

git config --global push.default simple
git config --global user.email "me@me.com"
git config --global user.name "Ny Name"
git config --global core.editor "vim"

# slower but better whitespace handling
git config --global alias.blame "blame -w -C -C -C"

# Reuse Recorded Resolution
# resolve merge conflicts only once when rebasing
git config --global rerere.enabled true
# auto stage recorded fixes for rerere
git config --global rerere.autoupdate true

git config --global alias.branches "branch -rv"
git config --global branch.sort -committerdate

# don't foget "git maintenance start"
